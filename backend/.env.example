# Copy manually only if .env does not exist. Never overwrite working credentials.
DJANGO_SECRET_KEY=<generate-a-random-secret-of-at-least-50-characters>
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DB_NAME=<existing-supabase-database-name>
DB_USER=<existing-supabase-user>
DB_PASSWORD=<existing-supabase-password>
DB_HOST=<existing-supabase-host>
DB_PORT=5432
DB_SSLMODE=require
# Comma-separated origins, no trailing slash. Supply actual frontend origins.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=True
API_DOCS_ENABLED=False
# True only when a trusted proxy strips and sets X-Forwarded-Proto.
TRUST_PROXY_SSL_HEADER=False
# Enable only after confirming every subdomain supports HTTPS and reviewing preload.
HSTS_INCLUDE_SUBDOMAINS=False
HSTS_PRELOAD=False

# --- Local development without Supabase -------------------------------------------
# True = config.settings.development uses SQLite at backend/db.sqlite3 and the DB_*
# values above are not needed. Ignored by every other settings module; production
# refuses to start if it is set.
DEV_USE_SQLITE=False

# --- Links in emails ----------------------------------------------------------------
# Base URL of the Next.js frontend; verification/reset emails link to
# {FRONTEND_URL}/auth/verify and {FRONTEND_URL}/auth/reset. Development defaults to
# http://localhost:3000; production requires an https:// URL.
FRONTEND_URL=http://localhost:3000

# --- Tax ----------------------------------------------------------------------------
# Percentage (e.g. 0, 5, 18). Checkout is disabled until this is set, except in
# development, which defaults to 0 with GST-inclusive prices.
ORDER_TAX_RATE=0
# True when catalogue prices already include tax ("Taxes included" in the UI).
ORDER_PRICES_INCLUDE_TAX=True

# --- Manual UPI payments ------------------------------------------------------------
# Uncomment to configure. Unset PAYMENT_UPI_ID hides payment instructions (uploads
# still work).
# Development defaults to the non-routable sample ID leezacakes.sample@example.
# PAYMENT_UPI_ID=
# PAYMENT_UPI_PAYEE_NAME=Leeza Cakes
# True marks the details as sample data so the UI can warn customers not to pay.
# PAYMENT_UPI_IS_SAMPLE=False

# --- Pickup slots (local time, TIME_ZONE=Asia/Kolkata); defaults shown ------------
# PICKUP_OPEN_HOUR=10
# PICKUP_CLOSE_HOUR=20
# PICKUP_SLOT_MINUTES=60
# PICKUP_DAYS_AHEAD=14
# Minimum notice; the slowest cake in the cart can require more.
# PICKUP_MIN_LEAD_MINUTES=240

# --- Public contact details for GET /api/v1/site/ -----------------------------------
# Uncomment to configure. Unset values are returned as null in production;
# development fills clearly fake sample values.
# SITE_BUSINESS_NAME=Leeza Cakes
# SITE_CONTACT_PHONE=
# SITE_CONTACT_EMAIL=
# The WhatsApp chat number is set in admin (WhatsApp & alert settings).
# SITE_INSTAGRAM=
# SITE_ADDRESS=
# SITE_PICKUP_HOURS_LABEL=
# SITE_CONTENT_IS_SAMPLE=False

# --- Notifications: email -------------------------------------------------------------
# Order notifications (customers) and new-order/payment alerts (staff) are emailed only
# when True. Development defaults to True with the console backend (printed by
# runserver); elsewhere configure SMTP first. Deliveries are recorded as "skipped" until
# then (see Django admin > Notifications > Delivery attempts).
# EMAIL_PROVIDER_ENABLED=False
# DEFAULT_FROM_EMAIL=Leeza Cakes <orders@your-domain.example>
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# EMAIL_TIMEOUT=10
# Public origin of this backend, used for Django admin links in staff alerts.
# Development defaults to http://127.0.0.1:8000; production requires https://.
# BACKEND_PUBLIC_URL=

# --- Notifications: WhatsApp and staff alert recipients ----------------------------
# Set up in Django admin, not here: Admin > Notifications > WhatsApp & alert settings
# holds the storefront chat number, the Meta Cloud API IDs and token, staff alert
# numbers/emails, templates and the webhook (see README "Notifications & WhatsApp").
#
# Encrypts the secrets saved there (WhatsApp access token, app secret). Required in
# production; development and tests use a fixed local key when it is unset. Keep it
# secret and stable: changing it means re-entering the secrets in admin. To rotate,
# list the new key first: FIELD_ENCRYPTION_KEY=<new>,<old>. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# FIELD_ENCRYPTION_KEY=

# Notification worker (python manage.py run_notification_worker). Defaults shown.
NOTIFICATION_MAX_ATTEMPTS=5
# Seconds to wait after the 1st, 2nd, … failed attempt; the last value repeats.
NOTIFICATION_RETRY_DELAYS=60,300,1800,7200
NOTIFICATION_LEASE_SECONDS=120
NOTIFICATION_WORKER_INTERVAL=2
NOTIFICATION_WORKER_BATCH_SIZE=20
