# Copy manually only if .env does not exist. Never overwrite working credentials.
DJANGO_SECRET_KEY=<generate-a-random-secret-of-at-least-50-characters>
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DB_NAME=<existing-supabase-database-name>
DB_USER=<existing-supabase-user>
DB_PASSWORD=<existing-supabase-password>
DB_HOST=<existing-supabase-host>
DB_PORT=5432
DB_SSLMODE=require
# Comma-separated origins, no trailing slash. Supply actual frontend origins.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=True
API_DOCS_ENABLED=False
# True only when a trusted proxy strips and sets X-Forwarded-Proto.
TRUST_PROXY_SSL_HEADER=False
# Enable only after confirming every subdomain supports HTTPS and reviewing preload.
HSTS_INCLUDE_SUBDOMAINS=False
HSTS_PRELOAD=False
